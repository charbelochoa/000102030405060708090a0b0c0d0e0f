{
  "name": "aeris-workspace",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "AERIS: collaborative agents, observable iterations and deliberate cost control",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n engine,web -c gray,cyan \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "server": "tsx server/index.ts",
    "cli": "tsx cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run typecheck && vite build && node scripts/build.mjs",
    "start": "node build/server/index.mjs",
    "desktop": "electron .",
    "desktop:build": "npm run tools:pack && npm run build && electron-builder --win portable --x64",
    "check": "npm run typecheck && npm test",
    "format": "prettier --write src server shared cli tests desktop scripts *.json *.ts docs README.md AGENTS.md",
    "tools:setup": "python scripts/setup_tools.py",
    "tools:pack": "python scripts/setup_tools.py --pack"
  },
  "build": {
    "appId": "dev.aeris.workspace",
    "productName": "AERIS",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "dist/**",
      "build/server/**",
      "skills/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "desktop/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "AERIS-${version}-Windows.exe"
    },
    "extraResources": [
      {
        "from": "build/worker/aeris-analysis",
        "to": "analysis"
      }
    ]
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "d3": "^7.9.2",
    "datascript": "^1.8.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.70.0",
    "markdown-it": "^15.0.3",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "author": "AERIS",
  "repository": {
    "type": "git",
    "url": "https://github.com/charbelochoa/000102030405060708090a0b0c0d0e0f.git"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "^11.0.1"
    },
    "@electron/universal": {
      "minimatch": "^11.0.1"
    }
  }
}
